# Скопируйте этот файл в .env и укажите ключ выбранного провайдера.
# Никогда не коммитьте .env с реальными ключами!

# Провайдер: gemini (по умолчанию) или anthropic
LLM_PROVIDER=gemini

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Необязательно: несколько ключей через запятую (у каждого проекта Google своя суточная квота).
# Агент чередует вызовы между ключами по кругу; ключ, исчерпавший квоту на модель, выбывает, остальные продолжают.
# GEMINI_API_KEYS=key1,key2,key3
# Модель обязательна. Старые модели Google закрывает для новых аккаунтов — смотрите список
# доступных вам моделей в AI Studio. Нужна модель с поддержкой JSON-режима (response_schema).
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую (можно оставить как есть). Агент переключается на следующую, если у текущей закончилась
# суточная квота (429) или она закрыта (404). Полезно на бесплатном тарифе: ~20 запросов в сутки на модель.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-4-hydrogen,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Необязательно: глубина размышлений по умолчанию (LOW | MEDIUM | HIGH). Агент сам выбирает уровень для каждого шага.
# GEMINI_THINKING=MEDIUM
# Необязательно: таймаут одного запроса, секунд (по умолчанию 240). Оборванный запрос повторяется.
# GEMINI_TIMEOUT_S=240

# --- Anthropic Claude (по желанию; чтобы работать на Claude: LLM_PROVIDER=anthropic и ключ ниже) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Основная модель; по умолчанию claude-opus-5-5. Подойдёт и claude-sonnet-5-5 (дешевле).
# ANTHROPIC_MODEL=claude-opus-5-5
# Запасные модели через запятую (по умолчанию claude-sonnet-5-5); пустое значение отключает запасные.
# ANTHROPIC_FALLBACK_MODELS=claude-sonnet-5-5
# Пауза между вызовами Claude, секунд (по умолчанию 0). LLM_MIN_INTERVAL ниже относится только к Gemini.
# ANTHROPIC_MIN_INTERVAL=0

# Пауза между стартами вызовов Gemini, секунд. Для бесплатного тарифа ставьте 3–6.
LLM_MIN_INTERVAL=3
