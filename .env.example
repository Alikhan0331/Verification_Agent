# Скопируйте этот файл в .env и укажите ключ выбранного провайдера.
# Никогда не коммитьте .env с реальными ключами!

# Провайдер: gemini (по умолчанию) или anthropic
LLM_PROVIDER=gemini

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Модель обязательна. Старые модели Google закрывает для новых аккаунтов — смотрите список
# доступных вам моделей в AI Studio. Нужна модель с поддержкой JSON-режима (response_schema).
GEMINI_MODEL=gemini-3.8-flash
# Необязательно: запасные модели через запятую. Агент переключается на следующую, если у текущей закончилась
# суточная квота (429) или она закрыта (404). Полезно на бесплатном тарифе: ~20 запросов в сутки на модель.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Необязательно: глубина размышлений по умолчанию (LOW | MEDIUM | HIGH). Агент сам выбирает уровень для каждого шага.
# GEMINI_THINKING=MEDIUM

# --- Anthropic (по желанию) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Пауза между стартами вызовов модели, секунд. Для бесплатного тарифа Gemini ставьте 3–6.
LLM_MIN_INTERVAL=3
