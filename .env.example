# Скопируйте этот файл в .env и укажите ключ выбранного провайдера.
# Никогда не коммитьте .env с реальными ключами!

# Провайдер: gemini (по умолчанию) или anthropic
LLM_PROVIDER=gemini

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Модель обязательна. Список доступных вам моделей и лимиты — в Google AI Studio.
# Рекомендуем Flash-линейку с поддержкой JSON-режима, например:
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (по желанию) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Пауза между вызовами модели, секунд. Для бесплатного тарифа Gemini (около 10 запросов/мин) ставьте 6–7.
LLM_MIN_INTERVAL=6
